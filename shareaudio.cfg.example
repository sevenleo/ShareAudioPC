# ShareAudioLite Startup Configuration Template
# Rename this file to 'shareaudio.cfg' and place it in the same directory
# as the executable (shareaudio_cli.exe or shareaudio_gui.exe) to use it.

# AUTOSTART (true | false)
# The master switch. If false or commented out, the configuration file
# will only pre-fill fields in the GUI and will not auto-start any sessions.
AUTOSTART=false

# TRAYMODE (true | false)
# GUI only. If true, minimizing or closing the GUI window hides it in the
# system tray instead of ending the app.
TRAYMODE=false

# STARTINTRAY (true | false)
# GUI only. If true, the GUI starts hidden in the system tray. This also
# enables tray mode for the current run.
STARTINTRAY=false

# MODE (server | client | both)
# Configures the mode for autostart.
# - 'server': starts sharing system audio.
# - 'client': connects and listens to the specified SERVER_IP.
# - 'both': GUI only; starts sharing and connects the receiver to SERVER_IP.
MODE=server

# AUDIO_MODE (balanced | fast | efficient)
# The audio stream transmission mode.
# - 'balanced': standard configuration (2048 bytes packets).
# - 'fast': low-latency configuration (1024 bytes packets).
# - 'efficient': Opus compressed mode for lower network usage.
AUDIO_MODE=balanced

# VOLUME_MODE (full | system)
# full keeps the captured signal unchanged.
# system follows the selected Windows output device master volume.
# On non-Windows platforms, system falls back to full.
VOLUME_MODE=full

# DEVICE_ID (string)
# Pre-selects a specific hardware capture audio device ID for the transmitter.
# If commented out or empty, it will use the system's default capture device.
# DEVICE_ID=

# PLAYBACK_DEVICE_ID (string)
# Pre-selects a specific hardware playback audio device ID for the receiver.
# If commented out or empty, it will use the system's default playback device.
# PLAYBACK_DEVICE_ID=

# SERVER_IP (string)
# The IP address or hostname of the transmitter/server to connect to.
# (This variable is required when MODE=client or MODE=both)
SERVER_IP=192.168.1.100
