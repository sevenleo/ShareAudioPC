{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (CLI, GUI & Tests with Opus)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "${sourceDir}/qt6/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/qt6/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/qt6/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/qt6/6.6.3/mingw_64",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "SHAREAUDIO_ENABLE_TESTS": "ON",
        "SHAREAUDIO_ENABLE_CONSOLE_UI": "ON",
        "SHAREAUDIO_ENABLE_DESKTOP_UI": "ON",
        "SHAREAUDIO_ENABLE_OPUS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/release-debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (CLI, GUI & Tests with Opus)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "${sourceDir}/qt6/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/qt6/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/qt6/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/qt6/6.6.3/mingw_64",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "SHAREAUDIO_ENABLE_TESTS": "ON",
        "SHAREAUDIO_ENABLE_CONSOLE_UI": "ON",
        "SHAREAUDIO_ENABLE_DESKTOP_UI": "ON",
        "SHAREAUDIO_ENABLE_OPUS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
