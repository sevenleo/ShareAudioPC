{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHAREAUDIO_ENABLE_TESTS": "ON",
        "SHAREAUDIO_ENABLE_CONSOLE_UI": "ON",
        "SHAREAUDIO_ENABLE_DESKTOP_UI": "OFF",
        "SHAREAUDIO_ENABLE_OPUS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
